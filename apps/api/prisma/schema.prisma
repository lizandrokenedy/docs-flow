generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DocumentType {
  id               String         @id @default(uuid())
  name             String
  description      String?
  allowedExtensions String[]
  allowedMimeTypes  String[]
  maxSizeBytes     Int            @default(10485760)
  icon             String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  workflowSteps    WorkflowStep[]

  @@map("document_types")
}

enum StepKind {
  DOCUMENT
  QUESTION
}

enum QuestionType {
  SINGLE_CHOICE
  SELECT
  YES_NO
  TEXT
  TEXTAREA
  NUMBER
  DATE
  MULTI_CHOICE
}

model Workflow {
  id               String         @id @default(uuid())
  name             String
  slug             String         @unique
  description      String?
  isActive         Boolean        @default(false)
  isTemplate       Boolean        @default(false)
  templateCategory String?
  version          Int            @default(1)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  steps            WorkflowStep[]
  submissions      Submission[]
  versions         WorkflowVersion[]

  @@map("workflows")
}

model WorkflowVersion {
  id          String   @id @default(uuid())
  workflowId  String
  version     Int
  snapshot    Json
  changeLabel String?
  createdAt   DateTime @default(now())
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
  @@map("workflow_versions")
}

model WorkflowStep {
  id                         String             @id @default(uuid())
  workflowId                 String
  documentTypeId             String?
  title                      String
  instructions               String?
  helpText                   String?
  exampleUrl                 String?
  position                   Int
  stepKind                   StepKind           @default(DOCUMENT)
  questionType               QuestionType?
  questionConfig             Json?
  conditionStepId            String?
  conditionValue             String?
  choiceOptions              String[]
  isRequired                 Boolean            @default(true)
  maxFiles                   Int                @default(1)
  acceptedExtensionsOverride String[]
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  workflow                   Workflow           @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  documentType               DocumentType?      @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  uploads                    StepUpload[]
  answers                    SubmissionAnswer[]

  @@unique([workflowId, position])
  @@map("workflow_steps")
}

enum SubmissionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

model Submission {
  id                  String             @id @default(uuid())
  workflowId          String
  status              SubmissionStatus   @default(IN_PROGRESS)
  workflowSnapshot    Json?
  currentStepPosition Int                @default(0)
  startedAt           DateTime           @default(now())
  completedAt         DateTime?
  workflow            Workflow           @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  uploads             StepUpload[]
  answers             SubmissionAnswer[]

  @@map("submissions")
}

model SubmissionAnswer {
  id             String       @id @default(uuid())
  submissionId   String
  workflowStepId String
  value          String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  submission     Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  workflowStep   WorkflowStep @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)

  @@unique([submissionId, workflowStepId])
  @@map("submission_answers")
}

model StepUpload {
  id             String       @id @default(uuid())
  submissionId   String
  workflowStepId String
  originalName   String
  storedName     String
  mimeType       String
  sizeBytes      Int
  createdAt      DateTime     @default(now())
  submission     Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  workflowStep   WorkflowStep @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)

  @@map("step_uploads")
}
